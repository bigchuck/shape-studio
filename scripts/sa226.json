{
  "version": "1.0",
  "description": "Generate single outline polygons for SA224 design",
  "author": "Mr. Chuck",
  "created": "2026-05-05",
  "comments": "Executable scripts for generating images. References templates from library.json",
  
  "template_libraries": [
    "library.json"
  ],
  
  "executables": {
    
    "gen226": {
      "description": "Basic polygon generator",
      "author": "Mr. Chuck",
      "created": "2026-10-11",
      "target_canvas": "MAIN",
      "comments": "Equal distribution of ops. Does not use new features.",
      "randomization": {
        "projection": {
          "type": "normal",
          "min": 0.5,
          "max": 1.5,
          "mean": 1.0,
          "std": 0.3
        },
        "iters": [10,25]
      },

      "commands": [
        {
          "template": "organic_outline_nofill",
          "params": {
            "name": "shape1",
            "break_width": "0.88",
            "__break_width": "0.01",
            "_break_width": "0.15",
            "projection": "2.0",
            "color": "black",
            "width": "3",
            "ops": "split_offset:1,sawtooth:1,squarewave:1,remove_point:1,distort_original:1",
            "dirbias": "random"
          }
        }
      ]
    },

    "gen226_lean_one": {
      "description": "Single leaner",
      "author": "Mr. Chuck",
      "created": "2026-10-11",
      "target_canvas": "MAIN",
      "comments": "Selection of single leaning sawtooth",
      "randomization": {
        "projection": {
          "type": "normal",
          "min": 0.5,
          "max": 1.5,
          "mean": 1.0,
          "std": 0.3
        },
        "iters": [10,25]
      },
      "optional_params": {
        "lean": "single",
        "weight_lean": 10
      },
      "commands": [
        {
          "template": "organic_outline_nofill",
          "params": {
            "name": "shape1",
            "width": "3",
            "ops": "split_offset:1,sawtooth:1,squarewave:1,remove_point:1,distort_original:1",
            "dirbias": "random",
            "lean_slant_max": "60",
            "_lean_slant_max": "(use 45 for less and 75 for more extreme)",
            "lean_extend_prob": ".88",
            "lean_extend_flank": "short",
            "_lean_extend_min": ".9",
            "_lean_extend_max": ".99"
          }
        }
      ]
    },
    "gen226_lean_two": {
      "description": "Double leaner",
      "author": "Mr. Chuck",
      "created": "2026-10-11",
      "target_canvas": "MAIN",
      "comments": "Selection of double leaning sawtooth",
      "randomization": {
        "projection": {
          "type": "normal",
          "min": 0.5,
          "max": 1.5,
          "mean": 1.0,
          "std": 0.3
        },
        "iters": [10,25]
      },
      "optional_params": {
        "lean": "pair",
        "weight_lean": 10
      },
      "commands": [
        {
          "template": "organic_outline_nofill",
          "params": {
            "name": "shape1",
            "break_width": "0.88",
            "__break_width": "0.01",
            "_break_width": "0.15",
            "projection": "2.0",
            "color": "black",
            "width": "3",
            "ops": "split_offset:1,sawtooth:1,squarewave:1,remove_point:1,distort_original:1",
            "dirbias": "random",
            "lean_slant_max": "30",
            "lean_ratio_min": "1.5",
            "lean_ratio_max": "2.5",
            "lean_extend_prob": ".4",
            "lean_extend_min": ".9",
            "lean_extend_max": ".99",
            "lean_cap_min": "0.2",
            "lean_cap_max": "0.4",
            "lean_pair_facing": "random",
            "lean_pair_gap_min": 0.1,
            "lean_pair_gap_max": 0.4,
            "lean_pair_extend_prob_inward": 0.3,
            "lean_pair_extend_prob_outward": 0.7

          }
        }
      ]
    },
    "gen226_lean_one_two": {
      "description": "Single and Double leaner",
      "author": "Mr. Chuck",
      "created": "2026-10-11",
      "target_canvas": "MAIN",
      "comments": "Selection of single and double leaning sawtooth",
      "randomization": {
        "projection": {
          "type": "normal",
          "min": 0.5,
          "max": 1.5,
          "mean": 1.0,
          "std": 0.3
        },
        "iters": [10,25]
      },
      "optional_params": {
        "lean": "both",
        "weight_lean": 10
      },
      "commands": [
        {
          "template": "organic_outline_nofill",
          "params": {
            "name": "shape1",
            "break_width": "0.25",
            "___break_width": "0.88",
            "__break_width": "0.01",
            "_break_width": "0.15",
            "projection": "2.0",
            "color": "black",
            "width": "3",
            "ops": "split_offset:1,sawtooth:1,squarewave:1,remove_point:1,distort_original:1",
            "dirbias": "random",
            "lean_slant_max": "30",
            "lean_ratio_min": "1.5",
            "lean_ratio_max": "2.5",
            "lean_extend_prob": ".4",
            "lean_extend_min": ".9",
            "lean_extend_max": ".99",
            "lean_cap_min": "0.2",
            "lean_cap_max": "0.4",
            "lean_pair_facing": "random",
            "lean_pair_gap_min": 0.1,
            "lean_pair_gap_max": 0.4,
            "lean_pair_extend_prob_inward": 0.3,
            "lean_pair_extend_prob_outward": 0.7

          }
        }
      ]
    },





    "gen226holdaside": {
      "description": "Single leaner",
      "author": "Mr. Chuck",
      "created": "2026-10-11",
      "target_canvas": "MAIN",
      "comments": "FIRST STEP Initial form as a block",
      "randomization": {
        "projection": {
          "type": "normal",
          "min": 0.5,
          "max": 1.5,
          "mean": 1.0,
          "std": 0.3
        },
        "iters": [10,25]
      },

      "commands": [
        {
          "template": "nofill_hollow",
          "params": {
            "name": "shape1",
            "break_width": "0.88",
            "__break_width": "0.01",
            "_break_width": "0.15",
            "projection": "2.0",
            "color": "black",
            "width": "3",
            "ops": "crook:10,lean_sawtooth:5,lean_sawtooth_pair:5,split_offset:1,sawtooth:1,squarewave:1,remove_point:1,distort_original:1",
            "dirbias": "random",
            "_lean_slant_max": "30",
            "_lean_ratio_min": "1.5",
            "_lean_ratio_max": "2.5",
            "_lean_extend_prob": ".6",
            "_lean_extend_min": ".6",
            "_lean_extend_max": ".9",
            "_lean_cap_min": "0.2",
            "_lean_cap_max": "0.4",
            "_lean_pair_facing": "outward",
            "_lean_pair_gap_min": "0.01",
            "_lean_pair_gap_max": "0.01",
            "_`lean_pair_extend_prob_inward": "0.3",
            "_lean_pair_extend_prob_outward": "0.7",
            "_crook_angle_min": "",
            "_crook_angle_max": "",
            "_crook_limb_ratio": "1.5",
            "_crook_min_width": "50",
            "_crook_min_length": "40",
            "_crook_center_jitter": "0.05",
            "_hollow_rim_min": "40",
            "_hollow_rim_max": "75",
            "_hollow_hollows_min": "2",
            "_hollow_hollows_max": "5",
            "_hollow_wall_min": "2",
            "_hollow_wall_max": "40",
            "_hollow_breakout": ".99",
            "_hollow_gap_min": "3",
            "_hollow_gap_max": "5",
            "_hollow_rough": "90",
            "_hollow_rough_spacing": "5",
            "hollow_simplify": "10"

          }
        }
      ]
    }

  }

}

