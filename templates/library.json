{
  "version": "1.0",
  "description": "Reusable shape generation templates",
  "templates": {
    "bg_shape": {
      "description": "Background layer organic shape",
      "commands": [
        "PROC dynamic_polygon ${name} VERTICES=${verts} BOUNDS=${bounds} ITERATIONS=${complexity} OPERATIONS=squarewave,split_offset DIRECTION_BIAS=random",
        "FILL ${name} ${fill}",
        "ALPHA ${name} ${alpha}",
        "ZORDER ${name} -100"
      ],
      "required_params": ["name", "bounds"],
      "optional_params": {
        "verts": "8,12",
        "complexity": "25",
        "fill": "lightgray",
        "alpha": "0.3"
      }
    },
    
    "focal_shape": {
      "description": "Focal element with sharp outlines",
      "commands": [
        "PROC dynamic_polygon ${name} VERTICES=${verts} BOUNDS=${bounds} ITERATIONS=${iters} OPERATIONS=${ops} DIRECTION_BIAS=${direction}",
        "COLOR ${name} ${color}",
        "WIDTH ${name} ${width}",
        "FILL ${name} NONE",
        "ZORDER ${name} 10"
      ],
      "required_params": ["name", "bounds"],
      "optional_params": {
        "verts": "5,8",
        "iters": "12",
        "ops": "sawtooth",
        "direction": "outward",
        "color": "black",
        "width": "2"
      }
    },
    
    "textured_shape": {
      "description": "Shape with fill and transparency",
      "commands": [
        "PROC dynamic_polygon ${name} VERTICES=${verts} BOUNDS=${bounds} ITERATIONS=${iters} OPERATIONS=split_offset,sawtooth",
        "COLOR ${name} ${outline}",
        "WIDTH ${name} ${width}",
        "FILL ${name} ${fill}",
        "ALPHA ${name} ${alpha}",
        "ZORDER ${name} ${zorder}"
      ],
      "required_params": ["name", "bounds"],
      "optional_params": {
        "verts": "6,10",
        "iters": "15",
        "outline": "#2C3E50",
        "width": "2",
        "fill": "#3498DB",
        "alpha": "0.6",
        "zorder": "0"
      }
    },
    
    "accent_line": {
      "description": "Simple line accent element",
      "commands": [
        "LINE ${name} ${start} ${end}",
        "COLOR ${name} ${color}",
        "WIDTH ${name} ${width}",
        "ZORDER ${name} ${zorder}"
      ],
      "required_params": ["name", "start", "end"],
      "optional_params": {
        "color": "black",
        "width": "3",
        "zorder": "20"
      }
    },

    "organic_outline_template": {
      "description": "Organic polygon outline - flowing natural forms",
      "target_canvas": "MAIN",
      "comments": "Template for organic shapes using sawtooth operations and inward bias. Creates smooth, flowing outlines.",
      "commands": [
        "PROC dynamic_polygon ${name} vertices=${verts} bounds=${bounds} iterations=${iters} operations=${ops} direction_bias=inward break_width_max=${break_width} projection_max=${projection} connect=${connect}",
        "COLOR ${name} ${color}",
        "WIDTH ${name} ${width}",
        "FILL ${name} ${fill}"
      ],
      "required_params": ["name","ops","fill"],
      "optional_params": {
        "verts": "6,10",
        "bounds": "100,100,668,668",
        "iters": "15",
        "break_width": "0.4",
        "projection": "1.5",
        "color": "black",
        "width": "2",
        "_fill": "white",
        "connect": "angle_sort"
      }
    },

    "organic_outline_nofill": {
      "description": "Organic polygon outline - flowing natural forms, with optional lean / crook / hollow",
      "target_canvas": "MAIN",
      "comments": "Flags: lean = none|single|pair|both, crook = yes|no, hollow = yes|no (hollow_breakout 0 = no break-outs, hollow_plug 0 = no plugged holes); fill = <color>|none, applied only when hollow. weight_lean / weight_crook set the added ops' weights. lean_* and crook_* params are passed straight to PROC; set one to \"\" to use the config default.",
      "commands": [
        "PROC dynamic_polygon ${name}",
        { "if": "${hollow}", "then": [
          "HOLLOW ${name} RIM=${hollow_rim_min},${hollow_rim_max} HOLLOWS=${hollow_hollows_min},${hollow_hollows_max} WALL=${hollow_wall_min},${hollow_wall_max} SPREAD=${hollow_spread} BREAKOUT=${hollow_breakout} PLUG=${hollow_plug} GAP=${hollow_gap_min},${hollow_gap_max} ROUGH=${hollow_rough} ROUGH_SPACING=${hollow_rough_spacing} SIMPLIFY=${hollow_simplify}",
          "FILL ${name} ${fill}"
        ]},
        "COLOR ${name} ${color}",
        "WIDTH ${name} ${width}"
      ],
      "proc_params": {
        "vertices": "${verts}",
        "bounds": "${bounds}",
        "iterations": "${iters}",
        "operations": "${ops}",
        "direction_bias": "${dirbias}",
        "break_width_max": "${break_width}",
        "projection_max": "${projection}",
        "connect": "${connect}",
        "squarewave_independent_directions": "${sqrwv_indep}"
      },
      "proc_passthrough": ["lean_*", "crook_*"],
      "ops_add": [
        { "if": "${lean} == single", "then": "lean_sawtooth:${weight_lean}" },
        { "if": "${lean} == pair",   "then": "lean_sawtooth_pair:${weight_lean}" },
        { "if": "${lean} == both",   "then": "lean_sawtooth:${weight_lean},lean_sawtooth_pair:${weight_lean}" },
        { "if": "${crook}",          "then": "crook:${weight_crook}" }
      ],
      "required_params": ["name","ops"],
      "optional_params": {
        "verts": "6,10",
        "bounds": "100,100,668,668",
        "iters": "15",
        "break_width": "0.4",
        "projection": "1.5",
        "color": "black",
        "width": "2",
        "fill": "none",
        "connect": "angle_sort",
        "dirbias": "inward",
        "sqrwv_indep": "False",

        "lean": "none",
        "weight_lean": "1",
        "lean_slant_max": "15",
        "lean_ratio_min": "3",
        "lean_ratio_max": "5",
        "lean_extend_prob": ".3",
        "lean_extend_min": ".3",
        "lean_extend_max": ".5",
        "lean_cap_min": "0.8",
        "lean_cap_max": "1.2",
        "lean_extend_flank": "long",
        "lean_pair_facing": "random",
        "lean_pair_gap_min": "0.0",
        "lean_pair_gap_max": "0.4",
        "lean_pair_extend_prob_inward": "0.3",
        "lean_pair_extend_prob_outward": "0.1",

        "crook": "no",
        "weight_crook": "1",
        "crook_angle_min": "30",
        "crook_angle_max": "90",
        "crook_limb_ratio": "3.0",
        "crook_min_width": "20",
        "crook_min_length": "80",
        "crook_center_jitter": "0.15",

        "hollow": "no",
        "hollow_rim_min": "12",
        "hollow_rim_max": "28",
        "hollow_hollows_min": "1",
        "hollow_hollows_max": "1",
        "hollow_wall_min": "8",
        "hollow_wall_max": "20",
        "hollow_spread": "0.3",
        "hollow_breakout": "0.3",
        "hollow_plug": "0",
        "hollow_gap_min": "12",
        "hollow_gap_max": "30",
        "hollow_rough": "6",
        "hollow_rough_spacing": "40",
        "hollow_simplify": "3"
      }
    },


    "compose_1": {
      "description": "Base composition template - visual defaults",
      "target_canvas": "MAIN",
      "comments": "Provides visual parameter defaults for COMPOSE operations",
      "commands": [
        {
          "command": "COMPOSE"
        }
      ],
      "required_params": [],
      "optional_params": {
        "bounds": "100,100,668,668",
        "color": "black",
        "width": "2"
      }
    }
  }
}

